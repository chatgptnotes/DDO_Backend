# Django
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Postgres (Supabase project — use the staging project for development)
DATABASE_URL=postgresql://postgres:password@db.your-staging-project.supabase.co:5432/postgres

# Supabase Auth — JWT verification
# Settings → API → JWT Settings → JWT Secret (HS256, default)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# Supabase project URL (only needed if backend calls Supabase service-role for admin ops)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ONLY-ON-BACKEND-NEVER-IN-FRONTEND

# CORS — frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://aisurgeonpilot.example.com,https://aidoccall.com

# ---- Stripe ----------------------------------------------------------------
# Server-side secret key (sk_test_... in dev). NEVER expose to the frontend.
STRIPE_SECRET_KEY=sk_test_replace_me
# Same publishable key used by the frontend; backend echoes it in /api/payments/intents/.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# `whsec_...` from `stripe listen` (local) or the Stripe dashboard webhook (prod).
# Required for /api/payments/webhooks/stripe/ — fail-closed if missing.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---- Stripe Connect --------------------------------------------------------
# Separate signing secret for the Connect webhook endpoint
# (/api/payments/webhooks/stripe/connect/). Get it from `stripe listen
# --forward-connect-to ...` locally, or the Connect webhook in the dashboard.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_replace_me
# Master switch — route patient payments through Connect destination charges.
# Keep False until clinics have onboarded (rollout Phase 2).
CONNECT_ENABLED=False
# Stripe-hosted Express onboarding returns the admin to these URLs (the
# AiSurgeonPilot clinic-admin Payments page).
CONNECT_ONBOARDING_RETURN_URL=http://localhost:3000/clinic-admin/payments?stripe=return
CONNECT_ONBOARDING_REFRESH_URL=http://localhost:3000/clinic-admin/payments?stripe=refresh

# ---- Email (payment confirmations) -----------------------------------------
# Defaults to console backend in dev — emails print to stdout.
# In prod, set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
# and provide SMTP credentials below (or swap in django-anymail / Resend).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AiDocCall <no-reply@aidoccall.com>

# ---- Consultation transcription --------------------------------------------
# Speech-to-text for in-person doctor/patient recordings. 'google' uses the
# free SpeechRecognition Google Web Speech backend and REQUIRES the `ffmpeg`
# binary installed on the host. ('whisper'/'gemini' reserved for later.)
TRANSCRIPTION_ENGINE=google
# Optional upload caps (bytes). Defaults: 25 MB file / 26 MB request.
# FILE_UPLOAD_MAX_MEMORY_SIZE=26214400
# DATA_UPLOAD_MAX_MEMORY_SIZE=27262976
